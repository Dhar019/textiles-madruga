{
    "name": "textiles-madruga-api",
    "main": "src/index.js",
    "compatibility_date": "2026-09-03",
    "compatibility_flags": [
        "nodejs_compat",
        "global_navigator",
        "streams_enable_constructors",
        "formdata_parser_supports_files"
    ],
    "vars": {
        "JWT_EXPIRE": "7d",
        "NODE_ENV": "production"
    },
    "kv_namespaces": [
        {
        "binding": "PRODUCTOS_KV",
        "id": "e4227e455ffe46a6ba849a14bebf6f66"
        }
    ],
    "observability": {
        "logs": {
        "enabled": true
        },
        "traces": {
        "enabled": true
        }
    }
}